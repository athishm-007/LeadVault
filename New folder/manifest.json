{
  "manifest_version": 3,
  "name": "LeadVault",
  "version": "1.1",
  "description": "Save leads and opportunities",

  "permissions": [
    "tabs"
  ],

  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },

  "web_accessible_resources": [
    {
      "resources": [
        "jspdf.umd.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}